<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_mantenimientos.xml: Layout para Mantenimientos, Daños y Captura con Cámara (RF05).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mantenimientos y Cámara (RF05)"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etIdInmueble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="ID del Inmueble Afectado"
        android:inputType="number" />

    <EditText
        android:id="@+id/etDescripcionDano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Descripción del Daño / Mantenimiento"
        android:inputType="text" />

    <Button
        android:id="@+id/btnTomarFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tomar Foto con la Cámara" />

    <TextView
        android:id="@+id/tvRutaFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Foto no capturada"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnGuardarMantenimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Guardar Reporte en Room/SQLite" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Reportes de Mantenimiento Registrados:"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMantenimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnVolverInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Volver al Dashboard" />

</LinearLayout>