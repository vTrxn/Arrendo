<?xml version="1.0" encoding="utf-8"?>
<!--
    item_contrato.xml: Tarjeta para cada fila en el RecyclerView de Contratos.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvContratoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contrato ID: #"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRelaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Inmueble ID: # | Inquilino ID: #" />

        <TextView
            android:id="@+id/tvFechasCanon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Fechas | Canon" />

        <TextView
            android:id="@+id/tvEstadoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Estado: Pendiente" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPagar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/btn_success_bg"
                android:text="Registrar Recibo (Al Día)" />

            <Button
                android:id="@+id/btnEliminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:backgroundTint="@color/btn_danger_bg"
                android:text="Eliminar" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>