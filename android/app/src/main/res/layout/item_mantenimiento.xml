<?xml version="1.0" encoding="utf-8"?>
<!--
    item_mantenimiento.xml: Tarjeta para cada fila en el RecyclerView de Mantenimientos.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvMantenimientoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: # - Inmueble ID: #"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descripción del daño" />

        <TextView
            android:id="@+id/tvRutaFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ruta Foto: -"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:backgroundTint="@color/btn_danger_bg"
            android:text="Eliminar" />

    </LinearLayout>
</androidx.cardview.widget.CardView>