<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema Base de la Aplicación Arrendo.
        Hereda de Theme.MaterialComponents.DayNight.NoActionBar con colores neutros corporativos.
        Estilo estrictamente plano (flat) profesional, sin glassmorphism y sin morado predeterminado.
    -->
    <style name="Theme.Arrendo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Color Primario de la Marca: Slate Neutro Profesional -->
        <item name="colorPrimary">@color/btn_neutral_bg</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores Secundarios -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Barra de Estado del Sistema Android -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/background_light</item>

        <!-- Estilo predeterminado de botones: Plano, Neutro y Limpio -->
        <item name="materialButtonStyle">@style/Widget.Arrendo.Button</item>
    </style>

    <!--
        Widget.Arrendo.Button:
        Define el aspecto visual neutro, limpio y plano de todos los botones <Button> del proyecto.
        Elimina el color morado predeterminado de Material 3, aplicando esquinas redondeadas suaves de 4dp.
    -->
    <style name="Widget.Arrendo.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_neutral_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">1dp</item>
    </style>
</resources>